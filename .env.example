# Local development — use the API running on your machine
API_INTERNAL_URL=http://127.0.0.1:4001

# Production (Vercel) — uncomment when testing against hosted API
# API_INTERNAL_URL=https://umq-api-api.vercel.app

# Browser uses same-origin proxy; Next.js rewrites /api/v1 → API_INTERNAL_URL
NEXT_PUBLIC_API_URL=/api/v1

# Local web dev only (optional)
WEB_ORIGIN=http://localhost:3000
